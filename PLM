# ---------------------------------------------------------------------------
# PLInit — make sure the tools, folders and sentinel files PLM assumes exist.
# Error out only if something is wrong
# ---------------------------------------------------------------------------
PLInit()
{
    local rc=0 cmd missing=()

    # --- hard dependencies -------------------------------------------------
    for cmd in qmmp fzf rg tmux; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=( "$cmd" )
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "PLInit: missing required program(s): ${missing[*]} — see README.md" >&2
        rc=1
    fi

    # --- soft dependencies: the feature degrades, PLM still runs ------------
    missing=()
    for cmd in batcat id3v2 python3; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=( "$cmd" )
    done
    [ "${#missing[@]}" -gt 0 ] && \
        echo "PLInit: optional utilities missing: ${missing[*]} (preview / monitor / tags / index)" >&2

    # --- library ------------------------------------------------------------
    if [ ! -d "$PLM_Library_Folder" ]; then
        echo "PLInit: library folder does not exist: '$PLM_Library_Folder'" >&2
        echo "hint: run PLSetLibrary to point PLM at a mounted library" >&2
        return 1
    fi

    # check if lib writable or not
    _PLM_probe_writable "$PLM_Library_Folder" || {
        _PLM_report_unwritable "$PLM_Library_Folder"
        return 1
    }

    # --- playlists folder + trash folder -----
    local dir
    for dir in "$PLM_PlayLists_Folder" "$PLM_PlayLists_Folder/../$PLM_TRASH_FOLDER"; do
        [ -d "$dir" ] && continue
        if mkdir -p "$dir"; then
            echo "PLInit: created $dir"
        else
            echo "PLInit: could not create $dir" >&2
            rc=1
        fi
    done

    local trashlog="$PLM_PlayLists_Folder/../$PLM_TRASH_FOLDER/$PLM_TRASH_LOG"
    [ -f "$trashlog" ] || { touch "$trashlog" && echo "PLInit: created $trashlog"; }

    # --- sentinel playlist: the dst picker lists it with find, so it has to
    #     be a real file or the delete option is simply absent ---------------
    _PLM_ensure_playlist "$PLM_PlayLists_Folder/$PLM_TRASH_PLAYLIST"

    # --- tag index (database) (only needed for PlayArtist) ----------------------
    local dbdir
    dbdir=$(dirname -- "$PLM_MUSIC_DB")
    [ -d "$dbdir" ] || mkdir -p "$dbdir" 2>/dev/null

    return "$rc"
}

