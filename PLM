# PlayTrack — search the LIBRARY (not playlists) for matching tracks, dump the
# selection to a tmp m3u, then play + manage it exactly like a playlist picked
# in PLayList (delegates to PLayList so the PLM management loop runs identically).
PlayTrack() {
    local TITLE
    if [ -n "$1" ]; then
        TITLE="$1"
    else
        read -r -p "Enter track/artist to search in library: " TITLE
    fi

    
    local lib_cmd="rg --files \"$PLM_Library_Folder\" 2>/dev/null | rg -i '$(_PLM_audio_regex)'" # find every audio file under the library folder. 

    # fzf picker over the library, seeded with the typed query, Tab for multi-select
    local SELECTED
    SELECTED=$(eval "$lib_cmd" | \
        fzf --multi \
            --query "$TITLE" \
            --prompt="Select track(s) [Tab=mark, Enter=play]: " \
            --preview 'basename {}' \
            --preview-window=up:1 \
            --bind "ctrl-q:execute(PLQuit)")

    if [ -z "$SELECTED" ]; then
        echo "No track selected."
        return 1
    fi

    # dump matched songs to a tmp m3u in /tmp
    local TRACK_PLAYLIST="/tmp/qmmp_track_playlist.m3u"
    {
        echo "$PLM_M3U_HEADER"
        printf '%s\n' "$SELECTED"
    } > "$TRACK_PLAYLIST"

    # play + manage as if it were a normal m3u selected from the library
    PLayList "$TRACK_PLAYLIST"
}

# PlayArtist — pick ONE track, then play everything by whoever made it.
#   1. fzf over the LIBRARY (same picker as PlayTrack, single selection)
#   2. load that pick into qmmp so `qmmp --status` becomes the source of truth
#      for its tags, exactly like the rest of PLM reads the current track
#   3. take ALBUMARTIST from the status, falling back to ARTIST when the file
#      carries no album-artist tag; if BOTH are null , error out
#   4. collect every library file whose ALBUMARTIST *or* ARTIST matches, by
#      querying the PLM_indexer.py tag index — case-insensitive substring, so
#      "feat." and multi-artist fields ("A; B") still hit
#   5. hand the assembled m3u to PLayList so the PLM management loop runs
# NOTE (?) like PlayTrack, the tmp m3u holds bare paths (no #EXTINF partner), so it
# deliberately does not satisfy the entry-pair invariant — PLManager's rg passes
# search for "EXTINF.*" and simply never match it. # Works, but never reviewed
PlayArtist() {
    # start mux interface
    if [ -z "$PLM_MUX_INNER" ] && [ -z "$PLM_NO_MUX" ]; then
        PlayList_mux PlayArtist "$@"
        return $?
    fi

    local QUERY
    if [ -n "$1" ]; then
        QUERY="$1"
    else
        read -r -p "Enter track/artist to search in library: " QUERY
    fi

    local lib_cmd="rg --files \"$PLM_Library_Folder\" 2>/dev/null | rg -i '$(_PLM_audio_regex)'" # library source: every audio file under the library folder . 

    # same controls as PLManager for everything that is not about an m3u entry:
    # player transport, reveal-in-explorer, quit, alt-h hints (see
    # _PLM_picker_binds).  The panel and the keys come from the one $PLM_KEY_*
    # set, so this screen cannot drift out of step with the manager's.
    _PLM_picker_binds 'basename {}' 'up:1'

    local SEED
    SEED=$(eval "$lib_cmd" | \
        fzf --no-multi \
            --query "$QUERY" \
            --prompt="Pick one track by the artist [Enter]: " \
            "${PLM_PICKER_BINDS[@]}")

    if [ -z "$SEED" ]; then
        echo "No track selected."
        return 1
    fi

    # ── load the seed so qmmp reports ITS tags ───────────────────────────────
    # remember what was playing, so we can tell the status actually turned over
    # guard with pgrep: `qmmp --status` with no running instance does not fail,
    # it STARTS one and blocks forever -- an unguarded call hangs PlayArtist here
    local PREV_TITLE=""
    pgrep -x qmmp >/dev/null 2>&1 && \
        PREV_TITLE=$(timeout 1 qmmp --status 2>/dev/null | grep -m1 '^TITLE' | cut -d'=' -f2-)

    QT_QPA_PLATFORM=offscreen qmmp "$SEED" >/dev/null 2>&1 & disown

    local i TITLE=""
    for i in {1..50}; do   # ~10s: qmmp cold-starts slower than it switches track
        TITLE=$(timeout 1 qmmp --status 2>/dev/null | grep '^TITLE' | cut -d'=' -f2-)
        [ -n "$TITLE" ] && [ "$TITLE" != "$PREV_TITLE" ] && break
        sleep 0.2
    done

    # anchored greps keep ARTIST and ALBUMARTIST apart without a `grep -v`, and
    # cut -f2- keeps tag values that themselves contain '=' intact (the
    # `awk -F"= "` idiom used elsewhere in PLM truncates those)
    local STATUS ALBUMARTIST ARTIST TARGET
    STATUS=$(timeout 2 qmmp --status 2>/dev/null)
    ALBUMARTIST=$(grep -m1 '^ALBUMARTIST' <<< "$STATUS" | cut -d'=' -f2- | sed 's/^ *//; s/ *$//')
    ARTIST=$(grep -m1 '^ARTIST'           <<< "$STATUS" | cut -d'=' -f2- | sed 's/^ *//; s/ *$//')
    TARGET="${ALBUMARTIST:-$ARTIST}"

    # no artist tag at all -> nothing to search on. Do not fall back to guessing
    # from the filename: that silently queues the wrong artist.
    if [ -z "$TARGET" ]; then
        echo "PlayArtist: no ARTIST or ALBUMARTIST for $(basename "$SEED") — aborting." >&2
        return 1
    fi
    echo "Artist: $TARGET"

    # ── gather every track by that artist from the tag index ─────────────────
    if [ ! -s "$PLM_MUSIC_DB" ]; then
        echo "No tag index yet — building it once (~30s)."
        PLMBuildIndex || return 1
    fi

    local matches
    matches=$("$PLM_INDEXER" artist-tracks --db "$PLM_MUSIC_DB" "$TARGET") || return 1
    if [ -z "$matches" ]; then
        echo "PlayArtist: nothing matched '$TARGET' (stale index? run PLMBuildIndex)." >&2
        return 1
    fi

    # drop rows whose file has since been trashed/moved — the index is a snapshot
    local ARTIST_PLAYLIST="/tmp/qmmp_artist_playlist.m3u"
    {
        echo "$PLM_M3U_HEADER"
        while IFS= read -r track; do
            [ -f "$track" ] && printf '%s\n' "$track"
        done <<< "$matches"
    } > "$ARTIST_PLAYLIST"

    local count
    count=$(( $(wc -l < "$ARTIST_PLAYLIST") - 1 ))
    if [ "$count" -le 0 ]; then
        echo "PlayArtist: every indexed track for '$TARGET' is missing on disk — run PLMBuildIndex." >&2
        return 1
    fi
    echo "Queued $count track(s) by $TARGET"

    # play + manage as if it were a normal m3u selected from the library
    PLayList "$ARTIST_PLAYLIST"
}

