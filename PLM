PlayList_mux() 
{
    local inner_cmd
    if [ "$#" -gt 0 ]; then
        printf -v inner_cmd '%q ' "$@"
    else
        inner_cmd="PLayList"
    fi

    # --- Configuration ---
    # Specify the log file you want to tail
    LOG_FILE=$PLM_LOG_FILE 
    rm $PLM_LOG_FILE 2>/dev/null 
    touch $PLM_LOG_FILE 
    touch $PLM_VIEW_FILE 

        TMP_FILE="/tmp/plm_log_update.$$" # Temporary file for processing

        # First, export monitorer script to tmp
        cp "$PLM_PATH/PLM_monitorer.sh" /tmp/PLM_monitorer.sh

        chmod +x  "$PLM_PATH/PLM_tag_editor.sh"
        chmod +x  /tmp/PLM_monitorer.sh
 
        # - first line continuously report song report
        # - fullscreen for tail (upper split) tracking of log
        #   size needs to be line instead of %
        # - report new song
        # - elegant exit


    # Write access check    
        local dir
        for dir in "$PLM_Library_Folder" "$PLM_PlayLists_Folder"; do
          [ -z "$dir" ] && continue
          [ -d "$dir" ] || continue          # PLInit creates the playlists folder
          _PLM_probe_writable "$dir" && continue
          _PLM_report_unwritable "$dir"
          return 1
        done


    FZF_INPUT_COMMAND="find . -type f" 
    # Specify the desired percentage height for the TOP pane (e.g., 20 for 20%)
    TOP_PANE_PERCENTAGE=20
    # --- End Configuration ---

    # Calculate the percentage height for the bottom pane
    BOTTOM_PANE_PERCENTAGE=$((100 - $TOP_PANE_PERCENTAGE))

    # Check if we are already inside a tmux session
    if [ -z "$TMUX" ]; then

        # TODO! init tmux also with bash
        tmux new-session -d -s "$PLM_tmux_session"
        # TODO! else, if tmux has 2 splits already , and in plm session, invoke inner PlayList
    fi

    for i in {1..10}; do
        tmux has-session -t "$PLM_tmux_session" 2>/dev/null && break
        sleep 0.1
    done 

    # 1. Split the current window vertically.
    #    The '-p' flag specifies the percentage for the *new* (bottom) pane.
    tmux split-window -v -l "$(( $(tput lines) + 2 ))" -t "$PLM_tmux_session" 
    
    # 2. Select the top pane.
    tmux select-pane -U -t "$PLM_tmux_session" 

    # 3. Send the command to tail the log file to the top pane.
    #    Using printf '%q' ensures the filename is correctly quoted/escaped.
    #    'C-m' simulates pressing Enter.
    tmux send-keys -t "$PLM_tmux_session" "clear; tput rmam; /tmp/PLM_monitorer.sh" C-m 
    PLM_STATUS_LOGGER_BACKGROUND_PID=$(cat /tmp/plm_logger.pid) 
     
 
    # 4. Select the bottom pane.
    tmux select-pane -D -t "$PLM_tmux_session" 

    # 5. Send the command to run fzf in the bottom pane.
    tmux send-keys -t "$PLM_tmux_session" "export PLM_MUX_INNER=1; $inner_cmd" C-m # this is the manager / player!

    # hand over control: enter
    tmux attach -t "$PLM_tmux_session"
} 
