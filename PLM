PLMTrashAllEntries() {
    filesrc=$1

    # Validate file exists
    if [[ ! -f "$filesrc" ]]; then
        echo "Error: playlist file '$filesrc' not found."
        return 1
    fi

    # Read all lines into array
    mapfile -t lines < "$filesrc"

    local i=0
    local total=${#lines[@]}
    local header_skipped=false

    # Skip the #EXTM3U header if present
    if [[ "${lines[0]}" == "$PLM_M3U_HEADER" ]]; then
        i=1
        header_skipped=true
    fi

    while (( i < total )); do
        local line="${lines[$i]}"

        # Check if this line starts a pair (#EXTINF metadata + filepath)
        if [[ "$line" == "#EXTINF:"* ]]; then
            local meta_line="$line"
            local meta_idx=$(( i + 1 ))   # 1-based line number for sed
            local path_idx=$(( i + 2 ))

            # Make sure the path line exists
            if (( meta_idx < total )); then
                local filepath="${lines[$meta_idx]}"
                filepath=$(echo "$filepath" | sed 's|\\|/|g' | tr -d '\r')

                echo "Deleting audio file: $filepath"

                # Move file to trash
                if [[ -f "$filepath" ]]; then
                    mv "$filepath" "../$PLM_TRASH_FOLDER"
                else
                    echo "  Warning: file not found on disk, skipping move: $filepath"
                fi

                # Log basename to trash log
                local basename_file
                basename_file=$(basename "$filepath")
                echo "$basename_file" >> "../$PLM_TRASH_FOLDER/$PLM_TRASH_LOG"

                # Log the M3U entry pair to trash log
                echo "$meta_line"                >> "../$PLM_TRASH_FOLDER/$PLM_TRASH_LOG"
                echo "${lines[$meta_idx]}"       >> "../$PLM_TRASH_FOLDER/$PLM_TRASH_LOG"

                i=$(( i + 2 ))  # advance past both lines of the pair
            else
                echo "  Warning: orphaned #EXTINF line at index $i, skipping."
                i=$(( i + 1 ))
            fi

        elif [[ "$line" == "#"* || -z "$line" ]]; then
            # Other comment or blank line — skip without trashing
            i=$(( i + 1 ))

        else
            # Bare filepath with no preceding #EXTINF
            local filepath
            filepath=$(echo "$line" | sed 's|\\|/|g' | tr -d '\r')

            echo "Deleting audio file (no metadata): $filepath"

            if [[ -f "$filepath" ]]; then
                mv "$filepath" "../$PLM_TRASH_FOLDER"
            else
                echo "  Warning: file not found on disk, skipping move: $filepath"
            fi

            local basename_file
            basename_file=$(basename "$filepath")
            echo "$basename_file" >> "../$PLM_TRASH_FOLDER/$PLM_TRASH_LOG"
            echo "$line"         >> "../$PLM_TRASH_FOLDER/$PLM_TRASH_LOG"

            i=$(( i + 1 ))
        fi
    done

    # Wipe the playlist content, preserving the header if there was one
    if [[ "$header_skipped" == true ]]; then
        echo "$PLM_M3U_HEADER" > "$filesrc"
    else
        > "$filesrc"
    fi

    echo "Done. All entries removed from $filesrc."
} 
 
