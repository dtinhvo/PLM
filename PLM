PLClean()
{

    PLClearDupes 
    # TODO! this is probably tested, but check for dir to run in  
    # TODO! Permadelete cleanup:
        PLM_DELETE_QUEUE="TBD" 
        # delete from file path
            #  for lines i+1
            # Delete m3u @ i,i+1
    # Delete all occurences in playlists? 

    temp_file=$(mktemp) 
    # Process the file line by line
    line_num=0 
    skip_next=false # check next line exists
        
    # Replace the original file with our processed version
    mv "$temp_file" "file.m3u" 
    while IFS= read -r line; do # some parsing
        ((line_num++))
        
        # If we need to skip this line (because it was processed in previous iteration)
        if $skip_next; then
            skip_next=false
            continue
        fi
        
        # Read the next line (file path)
        next_line=$(sed -n "$((line_num+1))p" file.m3u)
        
        # If there is a next line
        if [ -n "$next_line" ]; then
            # Remove the file pointed by the next line
            echo "Removing file: $next_line"
            rm -f "$next_line"
            
            # Skip the next line when continuing the loop
            skip_next=true
        else
            # If no next line, keep the current line in the output
            echo "$line" >> "$temp_file"
        fi
        
    done < "$PLM_DELETE_QUEUE"

    echo "Processing complete." 
} 
