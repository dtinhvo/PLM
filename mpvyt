ListenSeek(){
echo '{ "command": [ "seek", "'$(($1*60))'" ] }' | socat - "$PLM_MPV_SOCKET" > /dev/null 2>&1 &  
}
ListenNext(){
echo playlist-next | socat - "$PLM_MPV_SOCKET" > /dev/null 2>&1 &  
mpvadd 7 
}
ListenPrev(){
echo playlist-prev | socat - "$PLM_MPV_SOCKET" > /dev/null 2>&1 &  
mpvadd 7
}
ListenStat() {
echo '{ "command": ["get_property", "media-title"] }' | socat - "$PLM_MPV_SOCKET" | awk -F '"' '{print $4;}' | tee -a >(xclip -selection clipboard)
}

ListenStop()
{
    killall mpv > /dev/null 2>&1 &  
}

 
