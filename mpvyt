export PLM_MPV_SOCKET="/tmp/mpvsocket"             # mpvadd, ListenMid/Hi/Lo, ListenSeek/Next/Prev/Stat
 
listen()
{
nohup mpv "$1" --no-video --shuffle --ytdl-format=bestaudio > /dev/null 2>&1 &  
}
mpvadd(){
echo '{ "command": [ "seek", "+'$(($1*60))'" ] }' | socat - "$PLM_MPV_SOCKET"
}
