#!/bin/bash
 
export PLM_STATUS_LOGGER_BACKGROUND_PID=-1

export PLM_WINDOWS=0
 
export PLM_LOG_FILE="/tmp/qmmp_status.log" 
export PLM_VIEW_FILE="/tmp/PLM_view.log"
export PLM_qmmp_STATUS_FILE="/tmp/qmmpstatus.tmp"
export PLM_TRIMMED_LOG_FILE="/tmp/old_PLM_log.tmp"
export PLM_CONCAT_PLAYLIST="/tmp/qmmp_concat_playlist.m3u" # PLayList's multi-select merge target
# basename of the playlist qmmp currently holds.  Written by whoever loads a
# playlist (PLayList, ReselectPlayingList), read by PLM's loop and handed to
# PLManager as $4 — which is what picks the source playlist out of the search
# results, so a loader that forgets to write it leaves the whole screen on the
# previous playlist.
export PLM_ACTIVE_PLAYLIST_FILE="/tmp/qmmp_activePLaylist"

export PLM_tmux_session="PLMmux"
# where this package lives — 
export PLM_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export PLM_Library_Folder="${PLM_Library_Folder:-$HOME/Music/library}" # Re-sourcing PLM must not undo path choice.
export PLM_PlayLists_Folder_name="playlists" 
export PLM_MUSIC_DB_NAME="music_index.db"

export PLM_MEDIA_ROOTS="/media /media/$USER /run/media/$USER /mnt" # removable drives candidates
export PLM_MEDIA_DEPTH=3
 
# Playlist naming: {Prefix}{Separator}{...}
export PLM_FIXED_PLAYLIST_PREFIX="OK"           # Meant as finished, stable playlists
export PLM_TEST_PLAYLIST_PREFIX="Test"          # Meant as experimental, incoming addition, to be filtered, WIP, etc.
export PLM_PLAYLIST_SEPARATOR="_"               
export PLM_M3U_EXT=".m3u"
export PLM_M3U_HEADER="#EXTM3U"                 # header ("shebang") every m3u must open with
export PLM_TRASH_PLAYLIST="rm$PLM_M3U_EXT"      # manager selector/ dst playlist  : trash the track, recoverable
export PLM_NEW_PLAYLIST="new$PLM_M3U_EXT"       # manager selector/ dst playlist  : prompt for a new m3u
export PLM_NEW_PLAYLIST_PREFIX="$PLM_FIXED_PLAYLIST_PREFIX$PLM_PLAYLIST_SEPARATOR"  # pre-filled in that prompt
export PLM_Duplicates_File="${PLM_FIXED_PLAYLIST_PREFIX}${PLM_PLAYLIST_SEPARATOR}zDuplicates" # TODO this should be deprecated
export PLM_TRASH_FOLDER=".trash"
export PLM_TRASH_LOG="rm.log"
export PLM_Ressurect_Playlist="${PLM_TEST_PLAYLIST_PREFIX}${PLM_PLAYLIST_SEPARATOR}99_Resurrected$PLM_M3U_EXT"
export MANAGING_FLAG="/tmp/PLM_managingFlag"

# Playlist row colours — one scheme, two consumers: the PLayList picker and
# PLManager's search results.  The colour says WHICH KIND of playlist a row is,
# so it is keyed to the naming prefixes above and nothing else:
#   *$PLM_TEST_PLAYLIST_PREFIX*  -> _TEST   (staging / WIP)
#   everything else              -> _FIXED  (the $PLM_FIXED_PLAYLIST_PREFIX keepers)
# The _SRC variants are the same hue with reverse bg added: 
export PLM_COL_TEST='\x1b[1;4;33m'         # yellow 
export PLM_COL_FIXED='\x1b[1;4;32m'        # green
export PLM_COL_TEST_SRC='\x1b[1;4;7;33m'   # reverse bg
export PLM_COL_FIXED_SRC='\x1b[1;4;7;32m'  # reverse bg 
export PLM_COL_OFF='\x1b[0m'

# Key-hint colours in the alt-h sidebar.  The colour says WHAT A KEY TOUCHES —
# the four things PLM can act on — so a key that both moves an m3u entry and
# moves the audio file (the rm.m3u destination) is coloured by the file.
# Read through printf '%b', so the format is the \x1b[…m one used above.
export PLM_COL_KEY_PLAYLIST='\x1b[1;36m'   # cyan    - edits an m3u: move / copy / drop / mark
export PLM_COL_KEY_MP3='\x1b[1;35m'        # magenta - touches the audio file: tags, trash, reveal
export PLM_COL_KEY_QMMP='\x1b[1;34m'       # blue    - drives the player: skip, pause, reselect
export PLM_COL_KEY_PLM='\x1b[1;37m'        # white   - PLM's own UI: quit, reopen, this panel

# PLManager keybindings  - used also for hints
export PLM_KEY_MOVE="ctrl-x"
export PLM_KEY_COPY="ctrl-c"
export PLM_KEY_DELETE="ctrl-d"
export PLM_KEY_TAGS="ctrl-e"
export PLM_KEY_RESELECT="ctrl-r"
export PLM_KEY_QUIT="ctrl-q"
export PLM_KEY_NEXT="alt-n"                        # skip to the next track in qmmp
export PLM_KEY_PREV="alt-b"                        # back to the previous track
export PLM_KEY_PAUSE="alt-space"                   # pause / unpause (qmmp --play-pause)
export PLM_KEY_EXPLORER="alt-E"                    # reveal the mp3 in the file manager

export PLM_KEY_HINTS="alt-h"                    # toggles the key-hints sidebar

# hints sidebar for PLMmanager
export PLM_HINTS_FILE="/tmp/PLM_hints.txt"
export PLM_HINTS_FLAG="/tmp/PLM_hintsShown"
export PLM_HINTS_WINDOW="right,40,border-left"
export PLM_PREVIEW_WINDOW="up,60%,border-bottom,+{2}+3/3,~3"

# graphical file manager for $PLM_KEY_EXPLORER.  Empty = first one found
export PLM_FILE_MANAGER="${PLM_FILE_MANAGER:-}"

# audio files considered. 
# note: PlayArtist's index lookup only ever returns mp3.
export PLM_AUDIO_EXTS="mp3 wav flac aac ogg m4a"

# editor used by the rename bindings and the tag editor.  
export PLM_EDITOR="${EDITOR:-nvim}"


# fzf opt - i personally use this 
# Note: F2 messes up the rename workflow
export PLM_FZF_DEFAULT_OPTS="--color=bg+:#293739,bg:#1B1D1E,border:#808080,spinner:#E6DB74,hl:#7E8E91,fg:#F8F8F2,header:#7E8E91,info:#A6E22E,pointer:#A6E22E,marker:#F92672,fg+:#F8F8F2,prompt:#F92672,hl+:#F92672 \
                        --multi \
                         --reverse --keep-right --bind=alt-q:abort \
                         --bind 'pgup:page-up' \
                         --bind 'pgdn:page-down' \
                         --bind='alt-e:execute($PLM_EDITOR -c \"lua vim.g.resession_skip_save = true\" {+})'  \
                         --bind='alt-c:execute(cd $(dirname {+}))' \
                         --bind='shift-up:preview-page-up,shift-down:preview-page-down' \
                         --bind 'f2:execute($PLM_EDITOR {+} +RenameCurrent)' \
                         --bind 'ctrl-v:transform(echo \"put(\$(xclip -o -selection clipboard))\")' \
                         --bind='ctrl-x:execute(echo {1} | xargs realpath | head -c -1 | tee /dev/tty | xclip -selection clipboard)' \
                        "
 

# cosmetic variables
# tmux/monitorer layout
export PLM_logger_height=20
export PLM_status_height=9
export PLM_STATUS_HEIGHT=27   # true rendered height of the monitorer's status block, subtracted from the pane height to size the log tail
 
